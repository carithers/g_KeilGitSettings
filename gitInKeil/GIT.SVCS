[SVCS]
  DataBase=
  MenuItem=git-bash
    Command=cmd.exe /c "for /f "delims=" %i in ('where git') do start "" "%~dpi..\git-bash.exe""
    Arguments=
    Environment=
    RunMinimized=1
    QueryComment=0
    QueryRevision=0
    QueryCheckPoint=0
    Initial_Folder=./..
